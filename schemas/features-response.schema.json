{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "features-response.schema.json",
  "$defs": {
    "Feature": {
      "additionalProperties": true,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "direction": {
          "title": "Direction",
          "type": "string"
        },
        "coefficient": {
          "title": "Coefficient",
          "type": "number"
        }
      },
      "required": [
        "id",
        "name",
        "direction",
        "coefficient"
      ],
      "title": "Feature",
      "type": "object"
    }
  },
  "items": {
    "$ref": "#/$defs/Feature"
  },
  "type": "array"
}
